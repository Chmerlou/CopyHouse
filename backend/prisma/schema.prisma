generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PARTNER
}

enum ColorMode {
  BW
  COLOR
}

enum OrderStatus {
  CREATED
  PAID
  PRINTING
  READY
  ISSUED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  MOCK
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String       @map("password_hash")
  role          UserRole
  pickupPointId String?      @map("pickup_point_id") @db.Uuid
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id])
  documents     Document[]
  orders        Order[]
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([pickupPointId])
  @@map("users")
}

model Document {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  user         User        @relation(fields: [userId], references: [id])
  originalName String      @map("original_name")
  storagePath  String      @map("storage_path")
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  pageCount    Int         @map("page_count")
  createdAt    DateTime    @default(now()) @map("created_at")
  orderItems   OrderItem[]

  @@index([userId])
  @@map("documents")
}

model PickupPoint {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  address           String
  workingHours      String   @map("working_hours")
  pricePerPageBw    Int      @map("price_per_page_bw")
  pricePerPageColor Int      @map("price_per_page_color")
  commissionBps     Int      @map("commission_bps")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  users             User[]
  orders            Order[]

  @@map("pickup_points")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  user          User        @relation(fields: [userId], references: [id])
  pickupPointId String      @map("pickup_point_id") @db.Uuid
  pickupPoint   PickupPoint @relation(fields: [pickupPointId], references: [id])
  status        OrderStatus @default(CREATED)
  pageCount     Int         @map("page_count")
  pricePerPage  Int         @map("price_per_page")
  subtotal      Int
  commission    Int
  total         Int
  pickupCode    String?     @unique @map("pickup_code")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  items         OrderItem[]
  payment       Payment?

  @@index([userId])
  @@index([pickupPointId, status])
  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  order      Order     @relation(fields: [orderId], references: [id])
  documentId String    @map("document_id") @db.Uuid
  document   Document  @relation(fields: [documentId], references: [id])
  colorMode  ColorMode @map("color_mode")
  copies     Int
  pageCount  Int       @map("page_count")
  unitPrice  Int       @map("unit_price")
  lineTotal  Int       @map("line_total")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @unique @map("order_id") @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id])
  provider  PaymentProvider @default(MOCK)
  status    PaymentStatus
  amount    Int
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("payments")
}
